# #1161 T8: fixed Normal, the six orbit views only (orbit cost check after the noise unroll).
target 60
set quality_mode = manual
set atmosphere = normal
set marker_detail = normal
set resolution_3d = native
set shadows = off
set bloom = off
set planet_detail = normal
warm L10 lat=-30 lon=60 h=2 heading=0 time=3.625 chain=7.2.7.1.2.0.0.0.5 for=30 scenario=warmup
home-orbit L10 lat=-30 lon=60 h=2000000 heading=0 tilt=-90 time=3.625 chain=7.2.7.1.2.0.0.0.5 for=20 scenario=home-orbit
mercury-orbit L10 lat=-30 lon=60 h=2000000 heading=0 tilt=-90 time=2.125 chain=7.2.7.1.2.0.0.0.0 for=20 scenario=mercury-orbit
desert-orbit L10 lat=-30 lon=60 h=2000000 heading=0 tilt=-90 time=5.5 chain=7.2.7.2.3781.1.0.0.0 for=20 scenario=desert-orbit
iron-orbit L10 lat=-30 lon=60 h=2000000 heading=0 tilt=-90 time=28.625 chain=7.2.7.9.1294.1.0.0.1 for=20 scenario=iron-orbit
ice-orbit L10 lat=-30 lon=60 h=2000000 heading=0 tilt=-90 time=1.25 chain=7.2.7.1.303.1.0.0.1 for=20 scenario=ice-orbit
lava-orbit L10 lat=-30 lon=60 h=2000000 heading=0 tilt=-90 time=35.875 chain=7.2.7.5.4149.1.0.0.0 for=20 scenario=lava-orbit
end L10 lat=-30 lon=60 h=2 heading=0 time=3.625 chain=7.2.7.1.2.0.0.0.5 for=0 scenario=end

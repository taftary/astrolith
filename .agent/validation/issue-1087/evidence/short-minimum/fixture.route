# #1087: same geometry/view/time; lower fixed detail and 720-pixel short side.
target 60
set quality_mode = manual
set planet_detail = low
set marker_detail = low
set atmosphere = normal
set resolution_3d = 720
set shadows = off
set bloom = off
warm L10 lat=0 lon=0 h=2 heading=0 for=30 scenario=warmup
ground L10 lat=0 lon=0 h=2 heading=0 for=120 scenario=ground
end L10 lat=0 lon=0 h=2 heading=0 for=0 scenario=end

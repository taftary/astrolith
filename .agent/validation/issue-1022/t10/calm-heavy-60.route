# #1022 T10: Auto in a calm space view (two minutes), then on the heavy ground (one minute), at 60 FPS.
target 60
set target_fps = 60
calm   L4  x=0.1 y=0.2 z=3 dir=0,0,-1                       for=120 scenario=calm
ground L10 lat=10 lon=20 h=2 heading=0 tilt=-10 time=8      for=60  scenario=ground
end    L10 lat=10 lon=20 h=2 heading=0 tilt=-10 time=8      for=0   scenario=ground

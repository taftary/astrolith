# #1162 T7: home first, then ice and desert (carry-over check), for ABBA repeats.
target 60
set quality_mode = manual
set atmosphere = normal
set marker_detail = normal
set resolution_3d = native
set shadows = off
set bloom = off
set planet_detail = normal
warm L10 lat=-17.7099 lon=29.87377 h=2 heading=0 time=5.612 chain=7.2.7.1.2.0.0.0.5 for=30 scenario=warmup
home-coast-ground L10 lat=-17.7099 lon=29.87377 h=2 heading=0 time=5.612 chain=7.2.7.1.2.0.0.0.5 for=30 scenario=home-coast-ground
home-coast-ground-end L10 lat=-17.7099 lon=29.87387 h=2 heading=360 time=5.612 chain=7.2.7.1.2.0.0.0.5 for=0 scenario=waypoint
ice-coast-ground L10 lat=-13.57541 lon=-38.6295 h=2 heading=90 time=3.784 chain=7.2.7.1.303.1.0.0.1 for=30 scenario=ice-coast-ground
desert-coast-ground L10 lat=0.67194 lon=62.81022 h=2 heading=225 time=5.399 chain=7.2.7.2.3781.1.0.0.0 for=30 scenario=desert-coast-ground
end L10 lat=0.67194 lon=62.81022 h=2 heading=225 time=5.399 chain=7.2.7.2.3781.1.0.0.0 for=0 scenario=end

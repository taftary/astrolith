# #1162 T7: home sea and coast only (liquid water from the start), for ABBA repeats.
target 60
set quality_mode = manual
set atmosphere = normal
set marker_detail = normal
set resolution_3d = native
set shadows = off
set bloom = off
set planet_detail = normal
warm L10 lat=-22.51002 lon=76.35610 h=2 heading=0 time=2.546 chain=7.2.7.1.2.0.0.0.5 for=20 scenario=warmup
home-coast-ground L10 lat=-17.7099 lon=29.87377 h=2 heading=0 time=5.612 chain=7.2.7.1.2.0.0.0.5 for=30 scenario=home-coast-ground
home-coast-ground-end L10 lat=-17.7099 lon=29.87387 h=2 heading=360 time=5.612 chain=7.2.7.1.2.0.0.0.5 for=0 scenario=waypoint
home-coast-low L10 lat=-17.712 lon=29.87377 h=300 heading=0 tilt=-15 time=5.612 chain=7.2.7.1.2.0.0.0.5 for=20 scenario=home-coast-low
home-shallow L10 lat=-22.51002 lon=76.35610 h=2 heading=0 time=2.546 chain=7.2.7.1.2.0.0.0.5 for=20 scenario=home-shallow
end L10 lat=-17.7099 lon=29.87377 h=2 heading=0 time=5.612 chain=7.2.7.1.2.0.0.0.5 for=0 scenario=end

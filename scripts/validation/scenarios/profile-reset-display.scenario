# Separate new profile seeded with old-planet.toml. Views/player/Controls survive.
scenario-v2
seed 42
setup loaded
timeout 90
expect player.saved.filled eq true
expect views.saved.1.filled eq true
expect settings.saved.labels eq off
observe before-reset
click menu-button
click menu-Settings
click panel-item-display
wait ui.panel-item-performance.actionable eq true 5
click panel-item-performance
wait panel.selection eq performance 5
pointer 1100 450
scroll 0 -20
wait ui.reset-Reset-Display.actionable eq true 5
click reset-Reset-Display
expect player.saved.filled eq true
expect views.saved.1.filled eq true
expect views.saved.8.filled eq true
expect settings.saved.labels eq on
expect settings.saved.invert_look eq on
expect settings.saved.resolution_3d eq native
expect settings.saved.quality_mode eq auto
expect settings.saved.shadows eq off
expect settings.saved.bloom eq off
observe after-reset
key Escape down
key Escape up
quit

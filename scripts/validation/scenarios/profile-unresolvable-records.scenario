scenario-v2
seed 42
setup loaded
timeout 90
expect player.saved.filled eq true
expect player.saved.path eq 4294967295
expect player.remembered.path eq 7.2.7.1.2.0.0.0.5
expect views.saved.1.filled eq true
expect views.saved.1.destination eq 4294967295
expect settings.saved.labels eq off
expect settings.saved.invert_look eq on
observe unresolvable-records
click menu-button
click menu-Settings
click panel-item-views
wait panel.selection eq views 5
click views-go-0
expect player.mode eq Dive
expect navigation.destination.path eq 7.2.7.1.2.0.0.0.5
observe unresolved-go-keeps-live-destination
key Escape down
key Escape up
wait screen eq Menu 5
quit

# Initial --profile-fixture profiles/old-space.toml; legacy look is derived by core.
scenario-v2
seed 42
setup loaded
timeout 90
expect player.saved.filled eq true
expect player.remembered.path eq 7.2.7.1.2.0.0
expect player.remembered.yaw_rad range 0.7 0.7
expect views.saved.1.mode eq Free
expect views.saved.1.yaw_rad range 0.25 0.25
expect views.saved.1.pitch_rad range -0.15 -0.15
expect views.saved.1.forward present
expect settings.saved.labels eq off
expect settings.saved.invert_look eq on
expect settings.saved.game_time range 5432.25 5432.25
observe compatible-space
click menu-button
quit

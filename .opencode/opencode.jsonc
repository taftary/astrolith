{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "main",
  "permissions": [
    {
      "action": "read",
      "resource": ".env*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env*",
      "effect": "deny"
    }
  ],
  "mcp": {
    "servers": {
      "figma": {
        "type": "remote",
        "url": "https://mcp.figma.com/mcp"
      }
    }
  }
}
